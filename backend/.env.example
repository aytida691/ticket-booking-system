# Server
PORT=5000
NODE_ENV=development
CLIENT_ORIGIN=http://localhost:5173

# PostgreSQL
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/ticket_booking

# Auth
JWT_SECRET=change_this_to_a_long_random_string
JWT_EXPIRES_IN=7d

# Seat hold
SEAT_HOLD_TTL_MINUTES=10
HOLD_SWEEP_INTERVAL_SECONDS=15

# Waitlist offer
WAITLIST_OFFER_TTL_MINUTES=15

# Email (any free-tier SMTP works, e.g. Gmail app password, Mailtrap, Brevo)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password
EMAIL_FROM="Ticket Booking <no-reply@ticketbooking.com>"

# Used to build the booking confirmation / waitlist offer links
APP_BASE_URL=http://localhost:5173
